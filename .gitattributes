# Force LF line endings for shell scripts (husky hooks must not have CRLF)
.husky/* text eol=lf
*.sh text eol=lf

# Default: normalize to LF in the repo
* text=auto eol=lf

# Binary files (no conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
